{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "screen-record",
  "compatibility_date": "2026-10-15",
  "routes": [
    {
      "pattern": "record.garn.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
